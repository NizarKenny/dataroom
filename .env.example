# ── Supabase project: dataroom (tdbrkcruwlmhhhensopx, eu-central-1) ──

SUPABASE_URL=

# Publishable key. Ships in the frontend bundle; that is by design.
SUPABASE_PUBLISHABLE_KEY=

# Secret. Project Settings -> API Keys -> service_role. Never reaches the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Project Settings -> Database -> Connection string.
# Transaction pooler, port 6543. Runtime queries from the API.
DATABASE_URL=
# Direct connection, port 5432. Prisma migrations only.
DIRECT_URL=

SUPABASE_STORAGE_BUCKET=files

# ── API ──
# Which origins the browser may call this API from, comma separated. The default
# is the Vite dev server; a deployment that forgets it fails preflight and every
# write looks broken from the browser while curl still works.
WEB_ORIGIN=http://localhost:5173
PORT=8787

# ── Browser ──
# Vite only ever exposes variables prefixed with VITE_, which is what keeps the
# two secrets above out of the bundle. The first two repeat values from above on
# purpose: the prefix is the boundary, not the name.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_API_URL=http://localhost:8787
